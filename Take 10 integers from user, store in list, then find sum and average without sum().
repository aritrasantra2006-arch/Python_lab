number = []
print("Enter 10 integers:")
for i in range(10):
    val = int(input(f"Enter intege {i+1}:"))
    number.append(val)

    total_sum = 0
    for num in number:
        total_sum += num



        average = total_sum/len(number)

        print("List:", number)
        print("Sum:", total_sum)
        print("Average:", average)
